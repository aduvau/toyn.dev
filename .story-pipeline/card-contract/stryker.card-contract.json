{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test tests/card-contract.test.ts tests/system.test.ts tests/build.test.ts"
